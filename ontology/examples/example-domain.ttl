@prefix gai:  <https://ontology.geoai.local/core#> .
@prefix ex:   <https://ontology.geoai.local/domain/example#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# 시험·설명용 예시 분야. 실제 1년차 분야가 아니다.

<https://ontology.geoai.local/domain/example>
    a owl:Ontology ;
    owl:imports <https://ontology.geoai.local/core> ;
    owl:versionInfo "0.1.0" .

ex:Domain a gai:Domain ;
    rdfs:label "예시 분야"@ko .

ex:Labels a gai:LabelScheme ;
    rdfs:label "예시 라벨 체계"@ko .

ex:Building a skos:Concept ;
    skos:inScheme ex:Labels ;
    skos:prefLabel "건물"@ko ;
    gai:dtCorrespondsTo "Building" .
