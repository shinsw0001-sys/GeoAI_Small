{
  "$defs": {
    "Performative": {
      "description": "수행 의도. 화행 이론 기반 에이전트 통신 언어(FIPA ACL)의 부분집합.",
      "enum": [
        "request",
        "accept",
        "reject",
        "progress",
        "result",
        "failure",
        "event"
      ],
      "title": "Performative",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "메시지 봉투.",
  "properties": {
    "protocol_version": {
      "default": "0.1",
      "description": "메시지 규약 버전",
      "title": "Protocol Version",
      "type": "string"
    },
    "message_id": {
      "description": "메시지 고유 식별자",
      "title": "Message Id",
      "type": "string"
    },
    "conversation_id": {
      "description": "최상위 요청 하나의 생애 전체를 묶는 식별자. 하위 작업 메시지도 같은 값을 쓴다.",
      "title": "Conversation Id",
      "type": "string"
    },
    "correlation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "이 메시지가 답하는 요청 메시지의 message_id",
      "title": "Correlation Id"
    },
    "causation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "이 메시지를 직접 일으킨 메시지의 message_id (추적용)",
      "title": "Causation Id"
    },
    "performative": {
      "$ref": "#/$defs/Performative"
    },
    "sender": {
      "description": "보내는 에이전트 식별자",
      "pattern": "^[a-z][a-z0-9-]*$",
      "title": "Sender",
      "type": "string"
    },
    "recipient": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "받는 에이전트 식별자. event는 비워 둔다.",
      "title": "Recipient"
    },
    "project_id": {
      "description": "프로젝트 식별자",
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "task_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "이 메시지가 다루는 작업 식별자",
      "title": "Task Id"
    },
    "task_type": {
      "anyOf": [
        {
          "format": "uri",
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "작업 유형 온톨로지 IRI",
      "title": "Task Type"
    },
    "ontology_version": {
      "description": "보낸 쪽이 참조한 핵심 온톨로지 버전",
      "title": "Ontology Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deadline": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "응답 또는 완료 기한",
      "title": "Deadline"
    },
    "traceparent": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "W3C Trace Context 추적 문맥. 버스 전송 시 메시지 헤더로도 싣는다(OpenTelemetry 호환).",
      "title": "Traceparent"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    }
  },
  "required": [
    "performative",
    "sender",
    "project_id",
    "ontology_version"
  ],
  "title": "Envelope",
  "type": "object"
}
