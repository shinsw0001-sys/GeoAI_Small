{
  "$defs": {
    "DataAssetRef": {
      "additionalProperties": false,
      "description": "데이터·모델 저장소의 자산 참조.",
      "properties": {
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "asset_type": {
          "description": "데이터 자산 클래스 IRI (gai:DataAsset 하위)",
          "format": "uri",
          "minLength": 1,
          "title": "Asset Type",
          "type": "string"
        },
        "storage_uri": {
          "description": "예: s3://raw/site-a/ortho.tif",
          "minLength": 1,
          "title": "Storage Uri",
          "type": "string"
        },
        "crs": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "예: EPSG:5186",
          "title": "Crs"
        },
        "ground_sample_distance": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "미터 단위",
          "title": "Ground Sample Distance"
        },
        "acquired_at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "취득(촬영·측량) 일자. 온톨로지 gai:temporalExtent(time:Instant)에 대응. 다시기 분야의 시점 구분.",
          "title": "Acquired At"
        }
      },
      "required": [
        "asset_id",
        "asset_type",
        "storage_uri"
      ],
      "title": "DataAssetRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "outputs": {
      "items": {
        "$ref": "#/$defs/DataAssetRef"
      },
      "title": "Outputs",
      "type": "array"
    },
    "metrics": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Metrics",
      "type": "object"
    }
  },
  "title": "ResultPayload",
  "type": "object"
}
